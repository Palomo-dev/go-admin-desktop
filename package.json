{
  "name": "go-admin-desktop",
  "version": "0.1.8",
  "private": true,
  "description": "Go Admin Desktop — App de escritorio de GO Admin ERP. Conecta impresoras físicas (POS/PMS) con la nube y sirve de base para los módulos de escritorio.",
  "main": "dist/main/index.js",
  "scripts": {
    "sync-agent": "node scripts/sync-agent.js",
    "build": "npm run sync-agent && tsc -p .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "electron-updater": "^6.3.9",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "ws": "^8.21.1"
  },
  "optionalDependencies": {
    "escpos-bluetooth": "^3.0.0-alpha.2",
    "escpos-usb": "^3.0.0-alpha.4",
    "printer": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4"
  }
}
